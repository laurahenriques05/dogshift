{
  "name": "dogshift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc -b",
    "check:config": "node scripts/check-config.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test:ios:core": "swift run --package-path ios/RecorderCore RecorderCoreChecks"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@supabase/supabase-js": "^2.50.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/vite": "^4.1.0",
    "@types/google.maps": "^3.66.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
